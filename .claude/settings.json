{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/check-readme.sh",
            "statusMessage": "Checking if README needs updating..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 plugins/dc/skills/clear-read/scripts/lint_clear_read.py *)"
    ]
  }
}
